# URL of the backend API (see /server). Defaults to http://localhost:4000 if unset.
VITE_API_URL=http://localhost:4000

# Same Google OAuth Client ID as GOOGLE_CLIENT_ID in server/.env — see the
# comment there for how to create one. Safe to expose in frontend code
# (it's not a secret), but it must be the exact same value on both sides.
VITE_GOOGLE_CLIENT_ID=
